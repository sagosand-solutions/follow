{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/trace.schema.json",
  "title": "Precomputed source trace 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "traces"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "question_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
    "traces": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/trace"}
    }
  },
  "$defs": {
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["snippet_id", "source_sha256", "case_id", "stdin", "stdin_sha256", "steps", "stdout", "exception", "truncated"],
      "properties": {
        "snippet_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$", "description": "ID of the verification case for this exact snippet."},
        "stdin": {"type": "string", "description": "Exact UTF-8 text supplied to this snippet run; may be empty."},
        "stdin_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of stdin encoded as UTF-8."},
        "steps": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/step"}},
        "stdout": {"type": "string"},
        "exception": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/exception"}]},
        "truncated": {"type": "boolean"},
        "truncated_at_step": {"type": "integer", "minimum": 1, "maximum": 300, "description": "Number of recorded steps when the 300-step trace limit stopped recording. The player must say that the trace stops here because of the step limit."}
      },
      "allOf": [
        {"if": {"properties": {"truncated": {"const": true}}, "required": ["truncated"]}, "then": {"required": ["truncated_at_step"]}, "else": {"not": {"required": ["truncated_at_step"]}}}
      ]
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "event", "depth", "function", "locals", "stdout_len"],
      "properties": {
        "line": {"type": "integer", "minimum": 1, "description": "For line events, the source line to run next; for call/resume/yield/return/unwind/exception, the line where that event occurs."},
        "event": {"enum": ["line", "call", "resume", "yield", "return", "unwind", "exception"], "description": "line is the next source line to run; call is a frame's first entry; resume follows a recorded yield pause; yield pauses a generator/coroutine; return is normal completion; unwind is exit while an exception propagates; exception is an observed raise and may later be caught."},
        "depth": {"type": "integer", "minimum": 0},
        "function": {"type": "string"},
        "locals": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 80}},
        "stdout_len": {"type": "integer", "minimum": 0, "description": "Number of Unicode code points in stdout observed so far (not UTF-8 bytes or UTF-16 code units)."},
        "value": {"type": "string", "maxLength": 80},
        "exception": {"$ref": "#/$defs/exception"}
      },
      "allOf": [
        {"if": {"properties": {"event": {"enum": ["yield", "return"]}}, "required": ["event"]}, "then": {"required": ["value"]}},
        {"if": {"properties": {"event": {"enum": ["exception", "unwind"]}}, "required": ["event"]}, "then": {"required": ["exception"]}}
      ]
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "message", "line"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "maxLength": 200},
        "line": {"type": "integer", "minimum": 1}
      }
    }
  }
}
