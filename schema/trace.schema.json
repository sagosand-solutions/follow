{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/trace.schema.json",
  "title": "Precomputed source trace 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_id", "traces"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "question_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$"},
    "traces": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/trace"}
    }
  },
  "$defs": {
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["snippet_id", "source_sha256", "stdin_case", "steps", "stdout", "exception", "truncated"],
      "properties": {
        "snippet_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stdin_case": {"type": "integer", "minimum": 0},
        "steps": {"type": "array", "maxItems": 300, "items": {"$ref": "#/$defs/step"}},
        "stdout": {"type": "string"},
        "exception": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/exception"}]},
        "truncated": {"type": "boolean"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["line", "event", "depth", "function", "locals", "stdout_len"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "event": {"enum": ["line", "call", "return", "exception"]},
        "depth": {"type": "integer", "minimum": 0},
        "function": {"type": "string"},
        "locals": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 80}},
        "stdout_len": {"type": "integer", "minimum": 0},
        "value": {"type": "string", "maxLength": 80},
        "exception": {"$ref": "#/$defs/exception"}
      },
      "allOf": [
        {"if": {"properties": {"event": {"const": "return"}}, "required": ["event"]}, "then": {"required": ["value"]}},
        {"if": {"properties": {"event": {"const": "exception"}}, "required": ["event"]}, "then": {"required": ["exception"]}}
      ]
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "message", "line"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string", "maxLength": 200},
        "line": {"type": "integer", "minimum": 1}
      }
    }
  }
}
