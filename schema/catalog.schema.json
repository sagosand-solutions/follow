{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course catalog v1",
  "description": "The public course catalog. free_questions is checked against the course file by the exporter; premium.questions is set by hand (the private repository is not read at export time) and promises nothing about dates or prices. audience and path_step are optional labels for the home page: audience says who a course is for, path_step (1-3, unique in the catalog, checked by the exporter) puts it on the beginner path. A course with neither is shown as before.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data_version",
    "courses"
  ],
  "properties": {
    "data_version": {
      "const": 1
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
      }
    },
    "questionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "language",
        "free_questions",
        "start_question",
        "concept_map"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/courseId"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 160
            }
          ]
        },
        "language": {
          "enum": [
            "python"
          ]
        },
        "free_questions": {
          "type": "integer",
          "minimum": 1
        },
        "premium": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "questions"
          ],
          "properties": {
            "status": {
              "const": "coming-soon"
            },
            "questions": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "start_question": {
          "$ref": "#/$defs/questionId"
        },
        "concept_map": {
          "type": "string",
          "pattern": "^schema/concepts/[a-z0-9]+(?:-[a-z0-9]+)*-v0\\.json$"
        },
        "audience": {
          "enum": [
            "beginner",
            "experienced"
          ]
        },
        "path_step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "courseId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 40
    }
  }
}
