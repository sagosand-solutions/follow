{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course structure v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "language", "levels"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 40},
    "title": {"$ref": "#/$defs/text"},
    "language": {"enum": ["python"], "description": "The language the questions run in; every course is Python-run, so this stays python."},
    "levels": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"$ref": "#/$defs/level"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$", "not": {"pattern": "\\s"}},
    "questionId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$", "not": {"pattern": "\\s"}},
    "level": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "title", "lessons"],
      "properties": {
        "level": {"enum": ["beginner", "intermediate", "advanced"]},
        "title": {"$ref": "#/$defs/text"},
        "lessons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lesson"}}
      }
    },
    "lesson": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "builds_on", "questions"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "title": {"$ref": "#/$defs/text"},
        "builds_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/localId"}},
        "questions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/questionId"}},
        "summary": {
          "type": "string", "minLength": 1, "maxLength": 200,
          "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"}
        },
        "practice_summary": {
          "description": "Beginner courses: a fragment shown as 'You practised ...' once the lesson is answered. It says what was practised, never what the reader can now do.",
          "allOf": [{"$ref": "#/$defs/plain"}, {"maxLength": 80}]
        },
        "introductions": {
          "description": "Beginner courses: 'New word' cards shown above the code of the listed questions of this lesson (the exporter checks that they belong to it and that ids are unique in the lesson). The maximum lengths are the client's; authors aim for 120 characters or fewer.",
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "before_question_ids", "term", "explanation", "example"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
              "before_question_ids": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/questionId"}},
              "term": {"allOf": [{"$ref": "#/$defs/plain"}, {"maxLength": 60}]},
              "explanation": {"allOf": [{"$ref": "#/$defs/plain"}, {"maxLength": 240}]},
              "example": {"allOf": [{"$ref": "#/$defs/plain"}, {"maxLength": 240}]}
            }
          }
        }
      }
    },
    "plain": {
      "description": "One line of plain text: no control or line-break characters and no space at either end. The client shows it as text, with inline code at most.",
      "type": "string", "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "not": {"pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"}
    }
  }
}
