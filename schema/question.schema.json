{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question contract v0.1 and v0.2",
  "description": "Static interchange contract for one code-reading question, as plain-text JSON. Version 0.1 is the legacy standard question (five to eight options, no answer_profile). Version 0.2 requires an explicit answer_profile: standard (five to eight options) or beginner-practice (exactly four options: one full, one half, two zero-credit; local practice only, never scored on a server). Nothing is inferred and there is no fallback between versions or profiles. JSON Schema enforces field presence, types, value domains and score-dependent shape. Identifier uniqueness, score counts, cross-file references and other semantic rules are enforced by the validator, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "locale",
    "type",
    "level",
    "difficulty",
    "concepts",
    "prompt",
    "options",
    "explanation",
    "verification",
    "author",
    "license"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "answer_profile": {
      "enum": [
        "standard",
        "beginner-practice"
      ]
    },
    "id": {
      "$ref": "#/$defs/questionId"
    },
    "language": {
      "enum": [
        "python",
        "text"
      ]
    },
    "locale": {
      "const": "en"
    },
    "type": {
      "enum": [
        "output",
        "crashing-input",
        "remove-line",
        "equivalence",
        "complexity",
        "ai-review"
      ]
    },
    "level": {
      "$ref": "#/$defs/level"
    },
    "difficulty": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/conceptId"
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "snippets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/snippet"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "options": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "license": {
      "description": "Content license identifier. \"CC-BY-SA-4.0\" is the free public content license; \"LicenseRef-Proprietary\" marks private premium content whose rights come only from the rights-holder's separately distributed terms and grants no rights by itself. The public site export accepts only CC-BY-SA-4.0.",
      "enum": [
        "CC-BY-SA-4.0",
        "LicenseRef-Proprietary"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "answer_profile"
              ]
            },
            {
              "required": [
                "artifacts"
              ]
            }
          ]
        },
        "properties": {
          "options": {
            "minItems": 5,
            "maxItems": 8
          }
        },
        "required": [
          "snippets"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "0.2",
              "0.3"
            ]
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "answer_profile"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "answer_profile": {
                  "const": "standard"
                }
              },
              "required": [
                "answer_profile"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "minItems": 5,
                  "maxItems": 8
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "answer_profile": {
                  "const": "beginner-practice"
                }
              },
              "required": [
                "answer_profile"
              ]
            },
            "then": {
              "properties": {
                "options": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "not": {
          "required": [
            "artifacts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "python"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "required": [
          "snippets"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "text"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "required": [
          "artifacts"
        ],
        "not": {
          "required": [
            "snippets"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "snippets"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "cases": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "questionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "conceptId": {
      "type": "string",
      "pattern": "^(py|prod|sql)\\.[a-z][a-z0-9-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "level": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "snippet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "highlight_lines": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "score",
        "feedback",
        "misconception"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "enum": [
            0,
            0.5,
            1
          ]
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "misconception": {
          "oneOf": [
            {
              "$ref": "#/$defs/conceptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score": {
                "const": 1
              }
            },
            "required": [
              "score"
            ]
          },
          "then": {
            "properties": {
              "misconception": {
                "type": "null"
              }
            },
            "not": {
              "required": [
                "partial_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0
              }
            },
            "required": [
              "score"
            ]
          },
          "then": {
            "properties": {
              "misconception": {
                "type": "string"
              }
            },
            "not": {
              "required": [
                "partial_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "score": {
                "const": 0.5
              }
            },
            "required": [
              "score"
            ]
          },
          "then": {
            "properties": {
              "misconception": {
                "type": "string"
              }
            },
            "required": [
              "partial_reason"
            ]
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cases",
        "rationale"
      ],
      "properties": {
        "status": {
          "const": "specified"
        },
        "cases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/case"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "snippet_id",
        "stdin",
        "expected"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "snippet_id": {
          "$ref": "#/$defs/localId"
        },
        "stdin": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stdout",
        "exit_code"
      ],
      "properties": {
        "stdout": {
          "type": "string"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stderr_contains": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "exit_code": {
                "minimum": 1
              }
            },
            "required": [
              "exit_code"
            ]
          },
          "then": {
            "required": [
              "stderr_contains"
            ]
          }
        }
      ]
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "description": "Display-only text (never executed, never a trace): schema_version 0.3 only. sha256 is over the UTF-8 bytes of text exactly as stored (no BOM, no normalisation, no line-ending changes); provenance binds it to the output of an authoring fixture.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "format",
        "text",
        "sha256",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "enum": [
            "text",
            "diff",
            "http-transcript",
            "test-report",
            "policy"
          ]
        },
        "format": {
          "enum": [
            "plain",
            "unified-diff",
            "http-1.1-transcript"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "not": {
            "pattern": "[\\u0000-\\u0008\\u000b-\\u001f\\u007f-\\u009f\\u2028\\u2029]"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixture_id",
            "fixture_output_sha256"
          ],
          "properties": {
            "fixture_id": {
              "$ref": "#/$defs/localId"
            },
            "fixture_output_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "plain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "diff"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "unified-diff"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http-transcript"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "http-1.1-transcript"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "test-report"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "plain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "policy"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "format": {
                "const": "plain"
              }
            }
          }
        }
      ]
    }
  }
}
