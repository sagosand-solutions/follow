{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chapter examination contract v0.1 (explanation-only first subset)",
  "description": "Static interchange contract for one separately versioned chapter examination as plain-text JSON. This is not the question 0.1 contract. JSON Schema enforces field presence, types, value domains, per-object additionalProperties and code-point lengths. Identifier uniqueness, source hash binding, line bounds, rubric ordering, purpose coverage and study-reference resolution are enforced by validator/exam.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "chapter_id",
    "language",
    "locale",
    "version",
    "rubric_version",
    "source",
    "parts",
    "study_refs",
    "author",
    "license"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/localId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "chapter_id": {
      "enum": [
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "C06",
        "C07",
        "C08",
        "C09",
        "C10",
        "C11",
        "C12",
        "C13",
        "C14",
        "C15",
        "C16"
      ]
    },
    "language": {
      "const": "python"
    },
    "locale": {
      "const": "en"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "rubric_version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "parts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "study_refs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/studyRef"
      }
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "license": {
      "const": "CC-BY-SA-4.0"
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^py\\.[a-z][a-z0-9-]*$",
      "not": {
        "pattern": "\\s"
      }
    },
    "studyRef": {
      "type": "string",
      "pattern": "^(concept|lesson|question):[a-z][a-z0-9.-]{0,63}$",
      "not": {
        "pattern": "\\s"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "sha256",
        "environment",
        "execution_policy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "execution_policy": {
          "$ref": "#/$defs/executionPolicy"
        }
      }
    },
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "static-only"
        }
      }
    },
    "rubricItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "criteria"
      ],
      "properties": {
        "score": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "criteria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_hash",
        "snippet_id",
        "start_line",
        "end_line"
      ],
      "properties": {
        "source_hash": {
          "$ref": "#/$defs/hash"
        },
        "snippet_id": {
          "$ref": "#/$defs/localId"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "purpose",
        "prompt",
        "model_answer",
        "rubric",
        "max_points",
        "concepts",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "explanation"
        },
        "purpose": {
          "enum": [
            "purpose",
            "flow",
            "state",
            "failure",
            "risk",
            "transfer"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "model_answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        },
        "rubric": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rubricItem"
          }
        },
        "max_points": {
          "const": 2
        },
        "concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/conceptId"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
